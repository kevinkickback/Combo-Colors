{
  "name": "combo-colors",
  "version": "1.4.2",
  "description": "Automatically apply color to fighting game combo notations.",
  "main": "main.js",
  "scripts": {
    "dev": "node config/esbuild.config.mjs",
    "build": "tsc --skipLibCheck && node config/esbuild.config.mjs production",
    "lint": "npm run lint:biome && npm run lint:obsid && npm run lint:css",
    "lint:fix": "biome check --write . && npm run lint:obsid -- --fix && npm run lint:css -- --fix",
    "lint:biome": "biome ci .",
    "lint:css": "stylelint --config config/.stylelintrc.json \"src/**/*.css\"",
    "lint:obsid": "eslint --config config/eslint.config.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --config config/vitest.config.mts",
    "test:coverage": "vitest run --config config/vitest.config.mts --coverage",
    "test:run": "vitest run --config config/vitest.config.mts",
    "test:watch": "vitest watch --config config/vitest.config.mts",
    "version:check": "node scripts/check-release.mjs",
    "version": "node scripts/bump-version.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "Kevin Kickback",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.14.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^26.1.0",
    "obsidian": "^1.13.1",
    "stylelint": "^17.15.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "tslib": "2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
