{
  "name": "combo-colors",
  "version": "1.4.1",
  "description": "Automatically apply color to fighting game combo notation.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "biome ci . && eslint . && stylelint \"src/**/*.css\"",
    "lint:fix": "biome check --write . && eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "lint:biome": "biome ci .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:obsid": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.14.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^26.1.0",
    "obsidian": "latest",
    "stylelint": "^17.15.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "tslib": "2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
